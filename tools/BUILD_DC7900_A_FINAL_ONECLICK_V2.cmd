@echo off
setlocal
chcp 65001 >nul
title DC7900 A Final BIOS Builder
set "DC7900_WORKDIR=%~dp0"

powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "RC=%ERRORLEVEL%"

echo.
if not "%RC%"=="0" (
    echo [FAILED] Script stopped. DO NOT program any BIOS image.
) else (
    echo [OK] Build and verification finished.
)
echo.
pause
exit /b %RC%
